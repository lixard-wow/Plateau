package-as: Plateau

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  Plateau/Plateau: Plateau
  Plateau/Plateau_Options: Plateau_Options

externals:
  Plateau/Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
    tag: latest
  Plateau/Libs/CallbackHandler-1.0:
    url: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
    tag: latest
  Plateau/Libs/LibSharedMedia-3.0:
    url: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
    tag: latest
  Plateau/Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
  Plateau/Libs/LibDBIcon-1.0:
    url: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    tag: latest
  Plateau/Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    tag: 1.0.2-release

ignore:
  - .github
  - .gitattributes
  - .luacheckrc
  - tests
  - Plateau/Libs/.gitkeep
  - Plateau/Libs/LibDeflate/tests
  - Plateau/Libs/LibDeflate/examples
  - Plateau/Libs/LibDeflate/docs
  - Plateau/Libs/LibDeflate/.appveyor
  - Plateau/Libs/LibDeflate/.travis
  - Plateau/Libs/LibDeflate/*.yml
  - Plateau/Libs/LibDeflate/*.rockspec
  - Plateau/Libs/LibDeflate/.luacov
  - Plateau/Libs/LibDeflate/.luacheckrc
